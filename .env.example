# Feishu custom bot incoming webhook. Leave blank to log alerts without sending.
FEISHU_WEBHOOK_URL=
# Optional signing secret configured on the Feishu bot.
FEISHU_WEBHOOK_SECRET=

# PushPlus message token and ordinary-group topic for WeChat delivery.
PUSHPLUS_TOKEN=
PUSHPLUS_TOPIC=lakewatch20270205

CHECK_IN=2027-02-05
CHECK_OUT=2027-02-06
ADULTS=2
CURRENCY=NZD
CHECK_TIMEZONE=Pacific/Auckland
CHECK_CRON_MINUTE=7
RUN_ON_STARTUP=true
BROWSER_TIMEOUT_SECONDS=75
BROWSER_RETRIES=3
# Optional local Chromium path. Docker users should leave this blank.
CHROMIUM_EXECUTABLE_PATH=

DATABASE_PATH=/data/monitor.db
LOG_FILE=/data/monitor.jsonl
HOTELS_FILE=/app/hotels.json
LOG_RETENTION_DAYS=365

# Optional protection for POST /check. Sent as X-Admin-Token.
ADMIN_TOKEN=
